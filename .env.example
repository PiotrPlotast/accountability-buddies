# Copy to `.env` and fill in from the Supabase dashboard
# (Project settings → API). Both are safe to expose in a client bundle —
# the anon key is protected by row-level security, not secrecy.
#
# Expo inlines EXPO_PUBLIC_* at build time, so changing either of these
# requires rebuilding the dev client, not just restarting Metro.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key
