# Secrets for the Edge Functions (send-nudge, check-receipts,
# dispatch-notifications). Copy to `supabase/functions/.env`, fill in, then:
#
#   npx supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase into every function, so they don't belong here.

# expo.dev → Account settings → Access tokens. send-nudge and the dispatcher
# push through Expo with it.
EXPO_ACCESS_TOKEN=your-expo-access-token

# Any long random string (e.g. `openssl rand -hex 32`). check-receipts and
# dispatch-notifications run with verify_jwt = false and accept only this as a
# Bearer token. The pg_cron jobs send the same value from Vault, so it must
# match the `dispatch_secret` Vault secret exactly:
#
#   select vault.create_secret('https://<ref>.supabase.co', 'project_url');
#   select vault.create_secret('<same value as below>', 'dispatch_secret');
DISPATCH_SECRET=your-random-dispatch-secret
